<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ page_description }}">
<title>{{ page_title }}</title>
<link rel="shortcut icon" type="image/png" href="https://{{ host }}/icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap">
<style>
:root {
  --bg: #F7F7FB; --ink: #14162B; --body: #4C4F66; --mute: #63667F;
  --line: #E1E1EC; --accent: #2547E8; --ghost: #FFFFFF; --ghost-shadow: rgba(20,22,43,.16); --spark: #2547E8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0E0F1A; --ink: #EEEEF6; --body: #A2A5BC; --mute: #8A8DA6;
    --line: #22243A; --accent: #8AA8FF; --ghost: #F1F2FA; --ghost-shadow: rgba(0,0,0,.5); --spark: #8AA8FF;
  }
}
* { box-sizing: border-box; }
html, body { overflow-x: hidden; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Outfit', system-ui, sans-serif; -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }
a { color: var(--ink); text-decoration: none; }
a:hover { opacity: .7; }
.mark-link { text-decoration: none; padding-bottom: 1px; border-bottom: 1px solid var(--line); transition: border-bottom-width .2s cubic-bezier(.4,0,.2,1), border-color .2s cubic-bezier(.4,0,.2,1); }
.mark-link:hover { opacity: 1; color: var(--accent); border-bottom: 2px solid var(--accent); }
.coffee-rail { display: flex; }
.coffee-inline { display: none; }
nav { width: 100%; max-width: 720px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 28px; border-bottom: 1px solid var(--line); font-size: 15px; font-weight: 500; }
.split { flex: 1; min-height: 0; width: 100%; max-width: 720px; margin: 0 auto; display: grid; grid-template-columns: 288px 1fr; align-items: center; gap: 44px; padding: 72px 28px; }
.split-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; min-width: 0; }
.split-p { margin: 0; max-width: 38ch; font-size: 18px; font-weight: 300; line-height: 1.7; color: var(--body); }
.ghost-panel { position: relative; width: 288px; height: 300px; }
.box__ghost { position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); padding: 15px 25px 25px; }
.box__ghost .symbol:nth-child(1) { opacity: .55; animation: shine 4s ease-in-out 3s infinite; }
.box__ghost .symbol:nth-child(1):before,
.box__ghost .symbol:nth-child(1):after { content: ""; width: 12px; height: 4px; background: var(--spark); position: absolute; border-radius: 5px; bottom: 65px; left: 0; }
.box__ghost .symbol:nth-child(1):before { transform: rotate(45deg); }
.box__ghost .symbol:nth-child(1):after { transform: rotate(-45deg); }
.box__ghost .symbol:nth-child(2) { position: absolute; left: -5px; top: 30px; height: 18px; width: 18px; border: 4px solid var(--spark); border-radius: 50%; opacity: .55; animation: shine 4s ease-in-out 1.3s infinite; }
.box__ghost .symbol:nth-child(3) { opacity: .55; animation: shine 3s ease-in-out .5s infinite; }
.box__ghost .symbol:nth-child(3):before,
.box__ghost .symbol:nth-child(3):after { content: ""; width: 12px; height: 4px; background: var(--spark); position: absolute; border-radius: 5px; top: 5px; left: 40px; }
.box__ghost .symbol:nth-child(3):before { transform: rotate(90deg); }
.box__ghost .symbol:nth-child(3):after { transform: rotate(180deg); }
.box__ghost .symbol:nth-child(4) { opacity: .55; animation: shine 6s ease-in-out 1.6s infinite; }
.box__ghost .symbol:nth-child(4):before,
.box__ghost .symbol:nth-child(4):after { content: ""; width: 15px; height: 4px; background: var(--spark); position: absolute; border-radius: 5px; top: 10px; right: 30px; }
.box__ghost .symbol:nth-child(4):before { transform: rotate(45deg); }
.box__ghost .symbol:nth-child(4):after { transform: rotate(-45deg); }
.box__ghost .symbol:nth-child(5) { position: absolute; right: 5px; top: 40px; height: 12px; width: 12px; border: 3px solid var(--spark); border-radius: 50%; opacity: .55; animation: shine 1.7s ease-in-out 7s infinite; }
.box__ghost .symbol:nth-child(6) { opacity: .55; animation: shine 2s ease-in-out 6s infinite; }
.box__ghost .symbol:nth-child(6):before,
.box__ghost .symbol:nth-child(6):after { content: ""; width: 15px; height: 4px; background: var(--spark); position: absolute; border-radius: 5px; bottom: 65px; right: -5px; }
.box__ghost .symbol:nth-child(6):before { transform: rotate(90deg); }
.box__ghost .symbol:nth-child(6):after { transform: rotate(180deg); }
.box__ghost-container { background: var(--ghost); width: 116px; height: 116px; border-radius: 116px 116px 0 0; position: relative; margin: 0 auto; box-shadow: 0 10px 30px rgba(20,22,43,.10); animation: upndown 3s ease-in-out infinite; }
.box__ghost-eyes { position: absolute; left: 50%; top: 45%; height: 12px; width: 70px; transform: translate(-50%, 0); }
.box__eye-left, .box__eye-right { width: 13px; height: 13px; background: var(--ink); border-radius: 50%; margin: 0 10px; position: absolute; }
.box__eye-left { left: 0; }
.box__eye-right { right: 0; }
.box__ghost-bottom { display: flex; position: absolute; top: 100%; left: 0; right: 0; }
.box__ghost-bottom div { flex-grow: 1; position: relative; top: -10px; height: 20px; border-radius: 100%; background-color: var(--ghost); }
.box__ghost-bottom div:nth-child(2n) { top: -12px; margin: 0; border-top: 15px solid var(--bg); background: transparent; }
.box__ghost-shadow { height: 20px; box-shadow: 0 50px 16px 4px var(--ghost-shadow); border-radius: 50%; margin: 0 auto; animation: smallnbig 3s ease-in-out infinite; }
@keyframes upndown { 0% { transform: translateY(5px); } 50% { transform: translateY(15px); } 100% { transform: translateY(5px); } }
@keyframes smallnbig { 0% { width: 90px; } 50% { width: 100px; } 100% { width: 90px; } }
@keyframes shine { 0% { opacity: .5; } 25% { opacity: .18; } 50% { opacity: .5; } 100% { opacity: .5; } }
@media (prefers-reduced-motion: reduce) { .box__ghost-container, .box__ghost-shadow, .box__ghost .symbol { animation: none !important; } }
@media (max-width: 900px) { .coffee-rail { display: none; } .coffee-inline { display: inline-flex; } }
@media (max-width: 680px) {
  .split { grid-template-columns: 1fr !important; grid-auto-rows: min-content; align-content: center; justify-items: center; gap: 24px !important; padding: 40px 28px !important; text-align: center; }
  .split-copy { align-items: center !important; }
  .ghost-panel { width: 240px !important; height: 270px !important; }
}
</style>
</head>
<body>
<a class="coffee-rail" href="https://donate.nhat.me" target="_blank" rel="noopener noreferrer" style="position:fixed; right:20px; top:50%; transform:translateY(-50%); z-index:30; flex-direction:column; align-items:center; gap:8px; padding:16px 12px; border-radius:999px; background:var(--bg); border:1px solid var(--line); box-shadow:0 6px 20px rgba(20,22,43,.10); font-size:12px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent)">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Z"></path><path d="M17 9h1.6a2.4 2.4 0 0 1 0 4.8H17"></path><path d="M7 4.5c0 .8.8 1 .8 1.8"></path><path d="M11 4c0 .9.9 1.2.9 2.1"></path></svg>
  <span style="writing-mode:vertical-rl">Buy me a coffee</span>
</a>

<nav>
  <a href="https://nhat.me">About me</a>
  <a href="https://go.nhat.io">Go registry</a>
  <a href="https://{{ host }}" style="color:var(--accent)">Ligaturized fonts</a>
</nav>

<div class="split">
  <div class="ghost-panel">
    <div class="box__ghost">
      <div class="symbol"></div>
      <div class="symbol"></div>
      <div class="symbol"></div>
      <div class="symbol"></div>
      <div class="symbol"></div>
      <div class="symbol"></div>
      <div class="box__ghost-container">
        <div class="box__ghost-eyes">
          <div class="box__eye-left"></div>
          <div class="box__eye-right"></div>
        </div>
        <div class="box__ghost-bottom">
          <div></div>
          <div></div>
          <div></div>
          <div></div>
          <div></div>
        </div>
      </div>
      <div class="box__ghost-shadow"></div>
    </div>
  </div>
  <div class="split-copy">
    <h1 style="margin:0; font-size:52px; font-weight:600; line-height:1.05; letter-spacing:-0.04em">Whoops!</h1>
    <p class="split-p">It seems like we couldn't find the page you were looking for. <a class="mark-link" href="https://{{ host }}">Go back</a>.</p>
    <a class="coffee-inline" href="https://donate.nhat.me" target="_blank" rel="noopener noreferrer" style="padding:12px 24px; border-radius:999px; border:1px solid var(--line); font-size:15px; font-weight:500; color:var(--accent)">Buy me a coffee</a>
  </div>
</div>

<script>
(function () {
  var MAX_SHIFT = 6;

  document.addEventListener('mousemove', function (e) {
    var eyes = document.querySelector('.box__ghost-eyes');
    if (!eyes) return;
    var nx = (e.clientX / window.innerWidth) * 2 - 1;
    var ny = (e.clientY / window.innerHeight) * 2 - 1;
    eyes.style.transform = 'translate(calc(-50% + ' + (nx * MAX_SHIFT).toFixed(2) + 'px), ' + (ny * MAX_SHIFT).toFixed(2) + 'px)';
  });
})();
</script>
</body>
</html>
