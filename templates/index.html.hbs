<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ page_description }}">
<title>{{ page_title }}</title>
<link rel="shortcut icon" type="image/png" href="https://{{ host }}/icon.png" />
<link rel="preload" as="font" type="font/woff2" href="https://nhat.me/fonts/outfit.woff2?v=1" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="https://nhat.me/fonts/fira-code.woff2?v=1" crossorigin>
<link rel="stylesheet" href="https://nhat.me/css/style.min.css?v=1">
</head>
<body>
<div class="page">
<a class="coffee-rail" href="https://donate.nhat.me">
  <img src="https://nhat.me/images/coffee-mug.svg" width="18" height="18" alt="">
  <span style="writing-mode:vertical-rl">Buy me a coffee</span>
</a>

<nav>
  <a href="https://nhat.me">About me</a>
  <a href="https://go.nhat.io">Go registry</a>
  <a href="https://{{ host }}" class="nav-active">Ligaturized fonts</a>
</nav>

<div class="wrap">
  <div>
    <div class="specimen-box">
      <code class="specimen"><span style="color:#56B6C2">filter</span>(<span style="color:#ABB2BF">x</span> <span style="color:#56B6C2">-&gt;</span> <span style="color:#ABB2BF">x</span> <span style="color:#E06C75">%</span> <span style="color:#C678DD">2</span> <span style="color:#E06C75">!=</span> <span style="color:#C678DD">0</span>)</code>
    </div>
    <span class="specimen-note">Monospace fonts patched with Fira Code ligatures. Download a tarball and install it locally.</span>
  </div>

  <div class="list-head">
    <span id="list-count" class="list-count"></span>
    <input id="list-filter" class="list-filter" type="text" placeholder="Filter fonts" autocomplete="off">
  </div>

  <div id="list" class="list">
    {{#fonts}}
    {{^hidden}}
    <div class="row" data-search="{{ name }} {{ id }}">
      <div class="row-main">
        <div class="row-title">
          <span class="row-name">{{ name }}</span>
          {{#deprecated}}
          <span class="row-badge">Deprecated</span>
          {{/deprecated}}
        </div>
        <span class="row-meta">{{ ligaturized_version }}<a class="row-license" href="{{ license_url }}" target="_blank" rel="noopener noreferrer">{{ license }}</a></span>
      </div>
      <div class="row-end">
        <a class="row-download" href="{{ download_urls.no_chars }}">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"></path><path d="m7.5 11 4.5 4.5 4.5-4.5"></path><path d="M5 19h14"></path></svg>
          Download
        </a>
        <a class="row-chars" href="{{ download_urls.with_chars }}" title="With patched characters">+chars</a>
      </div>
    </div>
    {{/hidden}}
    {{/fonts}}
  </div>

  <p id="list-empty" class="empty">No font matches that filter.</p>

  <div class="note-card">
    <span class="note-label">About &ldquo;with characters&rdquo;</span>
    <p class="note-copy">The &ldquo;with characters&rdquo; zip, in addition to the ligatures, patches over some individual characters from Fira Code. This makes the transition between ligaturized and non-ligaturized versions of those characters less jarring, but also means the individual characters may look out of place in the surrounding text; which one is better depends on the font in question and personal preference. The specific characters that are patched over in &ldquo;with characters&rdquo; are: <code>&amp;^~*\|:=!&gt;-&lt;#%.+?;/_</code></p>
  </div>

  <div class="actions">
    <div class="actions-row">
      {{#source_url}}
      <a class="btn-solid" href="{{ source_url }}" target="_blank" rel="noopener noreferrer">Repository</a>
      {{/source_url}}
      <a class="btn-outline accent coffee-inline" href="https://donate.nhat.me">Buy me a coffee</a>
    </div>
  </div>
</div>
</div>

<script>
(function () {
  var rows = Array.prototype.slice.call(document.querySelectorAll('#list .row'));
  var countEl = document.getElementById('list-count');
  var emptyEl = document.getElementById('list-empty');
  var filterEl = document.getElementById('list-filter');

  function applyFilter() {
    var q = filterEl.value.trim().toLowerCase();
    var visible = 0;

    rows.forEach(function (row) {
      var match = !q || row.getAttribute('data-search').toLowerCase().indexOf(q) !== -1;
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    countEl.textContent = q ? (visible + ' of ' + rows.length + ' fonts') : (rows.length + ' fonts');
    emptyEl.style.display = visible === 0 ? '' : 'none';
  }

  filterEl.addEventListener('input', applyFilter);
  applyFilter();
})();
</script>
</body>
</html>
